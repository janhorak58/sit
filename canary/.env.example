# The default ASR needs no gated-model token; the ONNX weights are public. HF_TOKEN only
# raises Hugging Face download rate limits on first start.
HF_TOKEN=

# Keep loopback-only: the client reaches this through an SSH tunnel.
CANARY_BIND=127.0.0.1
CANARY_PORT=8208

# Any onnx-asr model name. nemo-canary-1b-v2 scores better on Czech FLEURS.
CANARY_MODEL=onnx-community/whisper-large-v3-turbo
CANARY_DEVICE=cuda
# Empty = full precision (best accuracy). Set to int8 to halve VRAM.
CANARY_QUANTIZATION=
CANARY_WINDOW_SECONDS=30
CANARY_MIN_SILENCE_MS=1000
CANARY_BATCH_SIZE=8
CANARY_DEFAULT_LANGUAGE=cs
# Free the GPU after this many idle seconds; the next request reloads the model.
# 0 keeps it loaded for good, and only then does PRELOAD_MODEL apply.
IDLE_EXIT_SECONDS=900
PRELOAD_MODEL=1
MAX_UPLOAD_BYTES=2147483648
