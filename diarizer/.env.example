# Token from an account that accepted the model terms at:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_replace_me

# Keep loopback-only when accessed through an SSH tunnel or reverse proxy.
DIARIZER_BIND=127.0.0.1
DIARIZER_PORT=8000

DIARIZE_MODEL=pyannote/speaker-diarization-3.1
DIARIZE_DEVICE=cuda
PRELOAD_MODEL=1
MAX_UPLOAD_BYTES=2147483648
